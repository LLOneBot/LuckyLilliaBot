# Shell scripts must use LF line endings
*.sh text eol=lf

# Dockerfiles: CRLF breaks backslash line continuations in RUN
Dockerfile* text eol=lf
*.Dockerfile text eol=lf

# Batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Native bundles are SHA256-verified byte for byte, including their text files.
# Preserve the canonical bundle bytes on every platform.
/src/native/production/** -text
/src/native/development/** -text
