{
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@common/types": ["../../../../../common/types"],
      "@ntqqapi/types": ["../../../protocol/nt-protocol/ntqqapi/types"],
      "@/common/types": ["../../../../../common/types"],
      "@/ntqqapi/types": ["../../../protocol/nt-protocol/ntqqapi/types"],
      "@shared/*": ["../../../../../common/*"],
      "@luckylillia/plugin-sdk/webui": ["../../../../../../packages/plugin-sdk/src/webui.ts"],
      "@/*": ["./*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "lucide-react": ["./node_modules/lucide-react"],
      "zustand": ["./node_modules/zustand"],
      "zustand/middleware": ["./node_modules/zustand/middleware"],
      "@tanstack/react-virtual": ["./node_modules/@tanstack/react-virtual"]
    },
    "types": ["vite/client"],
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true
  },
  "include": [
    "./**/*",
    "../../../../../common/types.ts",
    "../../../../../common/schema/**/*",
    "../../../protocol/nt-protocol/ntqqapi/types/**/*",
    "../../../protocol/qq-official/setupTypes.ts",
    "../../../protocol/qq-official/statsTypes.ts",
    "../../../tool/market/images.ts",
    "../../../../../version.ts",
    "../../../../../main/config/defaultConfig.ts",
    "../BE/types.ts",
    "../../../../../../packages/plugin-sdk/src/webui.ts",
    "../../../*/*/client/**/*"
  ],
  "exclude": ["node_modules"]
}
