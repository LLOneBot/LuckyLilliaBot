{
  "name": "@luckylillia/plugin-onebot11",
  "version": "1.0.0",
  "type": "module",
  "description": "NTQQ-only OneBot 11 adapter over HTTP, WebSocket, reverse WebSocket and HTTP POST",
  "main": "./lib/index.js",
  "files": [
    "lib"
  ],
  "author": {
    "name": "LLOneBot",
    "url": "https://github.com/LLOneBot"
  },
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLOneBot/LuckyLillia.Bot.git",
    "directory": "src/plugin/internal/adapter/onebot11"
  },
  "engines": {
    "node": ">=22.15"
  },
  "peerDependencies": {
    "@luckylillia/plugin-sdk": "^1.0.0"
  },
  "llbot": {
    "category": "adapter",
    "icon": "radio",
    "service": {
      "implements": [
        "onebot"
      ]
    },
    "description": {
      "zh": "仅支持 NTQQ 协议端的 OneBot 11 适配器，支持 HTTP、正向 / 反向 WebSocket 和 HTTP POST 上报",
      "en": "NTQQ-only OneBot 11 adapter over HTTP, WebSocket, reverse WebSocket and HTTP POST"
    },
    "title": "OneBot 11",
    "builtin": {
      "entry": "builtin:onebot11",
      "abi": 1
    },
    "webui": "./lib/client/index.js"
  }
}
