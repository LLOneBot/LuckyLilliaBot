{
  "name": "@luckylillia/plugin-email-notification",
  "version": "1.0.0",
  "type": "module",
  "description": "Sends an email when the account goes offline",
  "main": "./lib/index.js",
  "files": [
    "lib"
  ],
  "author": {
    "name": "LLOneBot",
    "url": "https://github.com/LLOneBot"
  },
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLOneBot/LuckyLillia.Bot.git",
    "directory": "src/plugin/internal/tool/email-notification"
  },
  "engines": {
    "node": ">=22.15"
  },
  "peerDependencies": {
    "@luckylillia/plugin-sdk": "^1.0.0"
  },
  "llbot": {
    "category": "tool",
    "icon": "mail",
    "service": {
      "implements": [
        "emailNotification"
      ]
    },
    "description": {
