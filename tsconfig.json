{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@luckylillia/plugin-sdk": [
        "./packages/plugin-sdk/src/index.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "examples",
    "scripts",
    "test/*.ts"
  ],
  "exclude": [
    "src/webui/FE",
    "src/**/client"
  ]
}
