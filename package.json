{
  "name": "lucky-lillia-bot",
  "version": "8.0.0",
  "type": "module",
  "description": "",
  "main": "dist/llbot.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch --exclude \"./data/**\" --exclude \"./examples/**\" --exclude \"../LuckyLillia.Plugins/**\" src/main/main.ts",
    "build": "npm run build:sdk && npm run build:builtins && vite build",
    "build:builtins": "node scripts/sync-builtin-manifests.mjs --check && node scripts/build-builtins.mjs",
    "build:sdk": "tsc -p packages/plugin-sdk && node packages/plugin-sdk/scripts/build-testing.mjs",
    "dev-webui": "npm --prefix src/plugin/internal/service/webui/FE run dev",
    "build-webui": "npm --prefix src/plugin/internal/service/webui/FE run build",
    "postinstall": "npm --prefix src/plugin/internal/service/webui/FE install && npm run build:sdk",
    "format": "prettier -cw .",
    "check": "tsc",
    "check:webui": "npm --prefix src/plugin/internal/service/webui/FE run check",
    "test:webui": "vitest run --config vitest.config.ts 'test/webui'",
    "test:unit": "vitest run --config vitest.config.ts 'test/unit'",
    "test": "vitest run --config vitest.config.ts"
  },
  "author": "",
  "license": "GPL-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@cordisjs/plugin-database": "^4.2.0",
    "@cordisjs/plugin-database-sqlite": "^5.2.0",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "@cordisjs/plugin-timer": "^1.1.4",
    "@hono/node-server": "^2.1.1",
    "@saltify/typeproto": "^0.4.1",
    "@satorijs/element": "^3.2.0",
    "@satorijs/protocol": "^1.7.0",
    "busboy": "^1.6.0",
    "compare-versions": "^6.1.1",
    "cordis": "4.0.0-rc.11",
    "cosmokit": "^1.8.1",
    "fast-xml-parser": "^5.11.1",
    "file-type": "^22.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "get-port": "^7.2.0",
    "hono": "^4.13.5",
    "image-size": "^2.0.2",
    "json5": "^2.2.3",
    "nodemailer": "^9.1.1",
    "qrcode": "^1.5.4",
    "schemastery": "^3.18.0",
    "semver": "7.8.5",
    "sift": "^17.1.3",
    "silk-wasm": "^3.7.1",
    "undici": "^7.18.2",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.12.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "milkygen": "^0.3.3",
    "ts-case-convert": "^2.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-cp": "^8.0.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.18.0"
}
