{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // cordis 4.0.0-rc.11 ships .d.ts files with extensionless relative imports, which NodeNext cannot follow
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Installed from npm, the gateway's own types; here, those of the build next door
    "paths": {
      "luckylillia-plugin-ai-gateway": ["../ai-gateway/lib/types.d.ts"]
    }
  },
  "include": ["src"]
}
